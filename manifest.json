{
  "manifest_version": 3,
  "name": "tldrman",
  "version": "1.0.0",
  "description": "Local-only Vivaldi Side Panel: summarize the active tab via OpenRouter free LLM.",
  "permissions": ["sidePanel", "scripting", "storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open tldrman",
    "default_icon": {
      "16": "icons/icon-16.png",
      "28": "icons/icon-28.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
